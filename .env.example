# Supabase PostgreSQL connection string (use the connection pooler, port 6543)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?sslmode=require"

# Secret used to sign admin session JWT cookies. Use a long random string:
#   openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Admin bootstrap account (used by prisma/seed.ts)
ADMIN_EMAIL="admin@maulanahafizali.com"
ADMIN_PASSWORD="ChangeMe123!"

# Optional: web3forms access key used as fallback email notification when a form is submitted
WEB3FORMS_ACCESS_KEY=""